# Node Environment
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# Database
# Standalone / MongoDB Atlas connection URI:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/citycare_hms?retryWrites=true&w=majority
# Set to true ONLY if you explicitly want an isolated, temporary in-memory database
USE_IN_MEMORY_DB=false

# Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters_random
JWT_EXPIRES_IN=7d

# Redis & BullMQ (Optional in local dev, in-memory fallback enabled if empty)
REDIS_URL=redis://127.0.0.1:6379

# Razorpay (Use test keys from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# AI Department Recommendation (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_optional


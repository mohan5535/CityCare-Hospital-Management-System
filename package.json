{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital Appointment Booking & Management System (HMS)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
